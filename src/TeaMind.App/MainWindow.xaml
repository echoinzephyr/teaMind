<Window x:Class="TeaMind.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:TeaMind.App">
  <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid x:Name="EditorView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="0"/><RowDefinition x:Name="DocumentTabsRow" Height="0"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <Grid Padding="8,0,138,0" Margin="0,24,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <DropDownButton x:Name="FileMenuButton" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="文件"><DropDownButton.Content><FontIcon Glyph="&#xE700;" FontSize="18"/></DropDownButton.Content><DropDownButton.Flyout><MenuFlyout x:Name="FileMenu" Placement="BottomEdgeAlignedLeft" ShouldConstrainToRootBounds="True">
          <MenuFlyoutItem Text="新建导图   Ctrl+N" Click="New_Click"/>
          <MenuFlyoutItem Text="打开 / 导入   Ctrl+O" Click="Open_Click"/>
          <MenuFlyoutSubItem x:Name="RecentMenu" Text="最近打开"/>
          <MenuFlyoutSeparator/>
          <MenuFlyoutItem Text="保存   Ctrl+S" Click="Save_Click"/>
          <MenuFlyoutItem Text="另存为   Ctrl+Shift+S" Click="SaveAs_Click"/>
          <MenuFlyoutItem x:Name="UndoButton" Text="撤销   Ctrl+Z" Click="Undo_Click"/>
          <MenuFlyoutItem x:Name="RedoButton" Text="重做   Ctrl+Y" Click="Redo_Click"/>
          <MenuFlyoutSeparator/>
          <MenuFlyoutItem Text="兼容性报告" Click="Report_Click"/>
          <MenuFlyoutItem Text="设置" Click="Settings_Click"/>
        </MenuFlyout></DropDownButton.Flyout></DropDownButton>
        <Button Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="返回主页" Click="Home_Click"><FontIcon Glyph="&#xE80F;" FontSize="18"/></Button>
        <Grid x:Name="TitleBar" Width="125" Height="56" Background="Transparent" Margin="6,0,0,0"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="DocumentTitle" Text="teaMind" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DocumentSaveState" Text="本地文件" FontSize="10" Opacity="0.55"/></StackPanel></Grid>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <AppBarButton Width="56" IsCompact="False" Icon="Add" Label="子主题" Click="AddChild_Click" ToolTipService.ToolTip="Tab"/>
        <AppBarButton Width="56" IsCompact="False" Icon="TwoPage" Label="同级" Click="AddSibling_Click" ToolTipService.ToolTip="Enter"/>
        <AppBarButton Width="56" IsCompact="False" Icon="Link" Label="联系" Click="Relationship_Click"/>
        <AppBarButton Width="56" IsCompact="False" Icon="OutlineStar" Label="概要" Click="Summary_Click"/>
        <AppBarButton Width="56" IsCompact="False" Icon="More" Label="插入"><AppBarButton.Flyout><MenuFlyout>
          <MenuFlyoutItem Text="图片…" Click="Image_Click"/><MenuFlyoutItem Text="附件…" Click="Attachment_Click"/>
          <MenuFlyoutItem Text="自由主题" Click="Floating_Click"/>
          <MenuFlyoutItem Text="关系线（选择两个主题）" Click="Relationship_Click"/>
          <MenuFlyoutItem Text="边界（选择相邻同级主题）" Click="Boundary_Click"/>
          <MenuFlyoutItem Text="概要（选择相邻同级主题）" Click="Summary_Click"/>
        </MenuFlyout></AppBarButton.Flyout></AppBarButton>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <AppBarButton Icon="FullScreen" Label="专注" Click="Focus_Click" IsCompact="False"/>
        <AppBarButton Icon="Bullets" Label="大纲" Click="Outline_Click" IsCompact="False"/>
        <AppBarButton Icon="Edit" Label="格式" Click="StyleToggle_Click" IsCompact="False"/>
        <AppBarButton Icon="Message" Label="AI" Click="AiPanel_Click" IsCompact="False"/>
        <AppBarButton Icon="Share" Label="导出" IsCompact="False"><AppBarButton.Flyout><MenuFlyout>
          <MenuFlyoutItem Text="PNG 图片…" Tag="png" Click="Export_Click"/><MenuFlyoutItem Text="SVG 矢量图…" Tag="svg" Click="Export_Click"/>
          <MenuFlyoutItem Text="PDF 文档…" Tag="pdf" Click="Export_Click"/><MenuFlyoutItem Text="Markdown…" Tag="md" Click="Export_Click"/>
          <MenuFlyoutItem Text="Xmind 文件…" Tag="xmind" Click="Export_Click"/>
        </MenuFlyout></AppBarButton.Flyout></AppBarButton>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2" Padding="8,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="DocumentTabs" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/></ScrollViewer>
      <Button Grid.Column="1" Content="＋" Click="New_Click" Background="Transparent" BorderThickness="0"/>
    </Grid>
    <Grid Grid.Row="3" Margin="12,0,12,0" CornerRadius="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="OutlineColumn" Width="0"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="0"/></Grid.ColumnDefinitions>
      <Grid x:Name="OutlinePanel" Visibility="Collapsed" Padding="14,18,10,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="导图大纲" FontWeight="SemiBold" FontSize="15" Margin="4,0,0,14"/>
        <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="查找主题…" TextChanged="Search_Changed" Margin="0,0,0,10"/>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"><StackPanel x:Name="OutlineItems" Spacing="2"/></ScrollViewer>
      </Grid>
      <Grid Grid.Column="1">
        <local:MapCanvas x:Name="MapView"/>
      </Grid>
      <Grid x:Name="InspectorPanel" Visibility="Collapsed" Grid.Column="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer x:Name="StylePanel" Padding="18,18,18,24" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8">
            <Grid><TextBlock Text="格式" FontSize="16" FontWeight="SemiBold"/><Button Content="×" HorizontalAlignment="Right" Click="StyleToggle_Click" Background="Transparent" BorderThickness="0" Padding="8,0"/></Grid>
            <TextBlock Text="导图" Style="{StaticResource PanelHeading}"/>
            <ComboBox x:Name="LayoutBox" Header="布局" HorizontalAlignment="Stretch" SelectionChanged="Layout_Changed">
              <ComboBoxItem Content="双向思维导图"/><ComboBoxItem Content="向右逻辑图"/><ComboBoxItem Content="向左逻辑图"/><ComboBoxItem Content="组织结构图"/><ComboBoxItem Content="树形图"/><ComboBoxItem Content="时间轴"/><ComboBoxItem Content="鱼骨图"/>
            </ComboBox>
            <ComboBox x:Name="ThemeBox" Header="主题" HorizontalAlignment="Stretch" SelectionChanged="Theme_Changed"/>
            <Button Content="均衡左右分支" Click="Rebalance_Click" HorizontalAlignment="Stretch"/>
            <TextBlock Text="选中主题" Style="{StaticResource PanelHeading}"/>
            <TextBox x:Name="TopicTextBox" Header="文字" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" LostFocus="TopicText_LostFocus"/>
            <NumberBox x:Name="FontSizeBox" Header="字号" Minimum="8" Maximum="96" SpinButtonPlacementMode="Inline" ValueChanged="FontSize_Changed"/>
            <TextBox x:Name="FontFamilyBox" Header="字体" LostFocus="FontFamily_LostFocus"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><ToggleButton x:Name="BoldButton" Content="B" FontWeight="Bold" Click="Bold_Click"/><ToggleButton x:Name="ItalicButton" Content="I" FontStyle="Italic" Click="Italic_Click"/><Button Content="恢复默认" Click="ResetStyle_Click"/></StackPanel>
            <ComboBox x:Name="ColorTargetBox" Header="配色对象" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="主题填充"/><ComboBoxItem Content="文字颜色"/><ComboBoxItem Content="边框 / 连线"/></ComboBox>
            <StackPanel x:Name="ColorSwatches" Orientation="Horizontal" Spacing="5"/>
            <TextBox x:Name="ColorHexBox" Header="自定义颜色（#RRGGBB）" PlaceholderText="#356451" LostFocus="ColorHex_LostFocus"/>
            <TextBox x:Name="TagsBox" Header="标签（逗号分隔）" LostFocus="Tags_LostFocus"/>
            <TextBox x:Name="MarkersBox" Header="图标 / 标记（逗号分隔）" PlaceholderText="★, ✓, priority-1" LostFocus="Markers_LostFocus"/>
            <TextBox x:Name="NotesBox" Header="备注" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="200" LostFocus="Notes_LostFocus"/>
            <TextBox x:Name="LinkBox" Header="超链接" PlaceholderText="https://…" LostFocus="Link_LostFocus"/>
            <Button Content="打开链接" Click="OpenLink_Click"/>
            <Button Content="展开 / 折叠分支" Click="Collapse_Click"/>
            <TextBlock Text="图片与附件" Style="{StaticResource PanelHeading}"/>
            <Button x:Name="RemoveImageButton" Content="移除图片" Click="RemoveImage_Click"/>
            <StackPanel x:Name="AttachmentItems" Spacing="4"/>
            <TextBlock Text="关系、边界与概要" Style="{StaticResource PanelHeading}"/>
            <StackPanel x:Name="DecorationItems" Spacing="4"/>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="AiPanel" Visibility="Collapsed" Padding="18">
          <StackPanel Spacing="12">
            <TextBlock Text="AI 思考助手" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="把零散灵感，整理成清晰脉络。结果将在确认后写入导图。" TextWrapping="Wrap" Opacity="0.65" FontSize="12"/>
            <ComboBox x:Name="AiModeBox" Header="操作" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="文字生成导图"/><ComboBoxItem Content="扩展选中分支"/><ComboBoxItem Content="整理与总结选中分支"/></ComboBox>
            <TextBox x:Name="AiInputBox" Header="内容 / 补充要求" PlaceholderText="写下一个主题，或粘贴要整理的文字…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="320"/>
            <Button Content="连接模型服务…" Click="Settings_Click"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="AiGenerateButton" Content="生成预览" Click="AiGenerate_Click"/><Button x:Name="AiCancelButton" Content="取消" Click="AiCancel_Click" IsEnabled="False"/></StackPanel>
            <ProgressRing x:Name="AiProgress" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left"/>
            <TextBlock x:Name="AiStatusText" TextWrapping="Wrap" FontSize="12"/>
            <TextBox x:Name="AiPreviewBox" Header="预览" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" MaxHeight="450"/>
            <Button x:Name="AiApplyButton" Content="确认应用到导图" IsEnabled="False" Click="AiApply_Click"/>
            <Button Content="返回样式面板" Click="StylePanel_Click"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Grid Grid.Row="4" Padding="12,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="SheetTabs" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
      <TextBlock x:Name="StatusText" Grid.Column="1" Text="本地优先 · 自由创作" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="12,0"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center"><Button Content="−" Click="ZoomOut_Click" Padding="8,0" Background="Transparent" BorderThickness="0"/><TextBlock x:Name="ZoomLabel" Text="100%" Width="42" TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/><Button Content="＋" Click="ZoomIn_Click" Padding="8,0" Background="Transparent" BorderThickness="0"/><Button Content="适应" Click="Fit_Click" Padding="8,0" Background="Transparent" BorderThickness="0"/></StackPanel>
    </Grid>
  </Grid>
  <Grid x:Name="HomeView" Padding="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="14,24,14,16">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,30"><Border Width="28" Height="30" CornerRadius="7" Background="{StaticResource TeaAccentBrush}"><TextBlock Text="茶" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="teaMind" FontSize="23" FontWeight="SemiBold"/></StackPanel>
        <StackPanel Grid.Row="1" Spacing="6">
          <TextBlock Text="让想法，自由生长" FontSize="12" Opacity="0.55" Margin="8,0,0,20"/>
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{StaticResource TeaAccentBrush}" Foreground="White" BorderThickness="0" Height="40" Click="HomeAi_Click"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE945;" FontSize="16"/><TextBlock Text="AI 生成导图"/></StackPanel></Button>
          <Button x:Name="RecentNavButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Height="40" Click="HomeRecent_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE823;" FontSize="16"/><TextBlock Text="最近"/></StackPanel></Button>
          <Button Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Height="40" Click="Open_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8E5;" FontSize="16"/><TextBlock Text="打开本地文件"/></StackPanel></Button>
          <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,12"/>
          <Button x:Name="FavoritesNavButton" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Height="40" Click="HomeFavorites_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE734;" FontSize="16"/><TextBlock Text="收藏"/></StackPanel></Button>
          <Button Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Height="40" Click="HomeOpenDocs_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8F1;" FontSize="16"/><TextBlock Text="当前打开的导图"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Grid.Row="3" Spacing="14"><Button Content="⚙  设置" Click="Settings_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left"/><TextBlock Text="本地优先 · 无需登录" FontSize="11" Opacity="0.45" Margin="10,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,0,0,0">
      <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
        <Grid x:Name="HomeTitleBar" Background="Transparent"><TextBlock x:Name="HomeHeading" Text="最近" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
        <TextBox x:Name="HomeSearch" Grid.Column="1" PlaceholderText="搜索导图…" VerticalAlignment="Center" TextChanged="HomeSearch_Changed"/>
      </Grid>
      <TextBlock x:Name="HomeDescription" Grid.Row="1" Text="从一个想法开始，或接着上次的思考。" Opacity="0.5" FontSize="12" Margin="0,4,0,24"/>
      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" Padding="0,0,20,20">
        <ItemsControl x:Name="HomeCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
  <Grid x:Name="WindowDragRegion" Height="24" VerticalAlignment="Top" Margin="0,0,138,0" Background="Transparent" />
  </Grid>
</Window>
